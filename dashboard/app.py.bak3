    st.markdown(stat_card("📊", "Baseline Energy", f"{base_v} {base_u}", "Fixed-schedule run", "#4a5568"), unsafe_allow_html=True)
with c2:
    ai_v, ai_u = joules_to_display(ai_energy_j)
    st.markdown(stat_card("🤖", "AI-Controlled Energy", f"{ai_v} {ai_u}", f"{ai_cycles} cycles logged", "#4299e1"), unsafe_allow_html=True)
with c3:
    cv = comfort_viol if comfort_viol is not None else "—"
    st.markdown(stat_card("🎯", "Comfort Violations", str(cv), "Setpoints outside 21–24°C", "#9f7aea"), unsafe_allow_html=True)

