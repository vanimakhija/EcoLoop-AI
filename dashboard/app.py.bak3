""", unsafe_allow_html=True)

# Page content wrapper
st.markdown('<div class="page-wrap">', unsafe_allow_html=True)

# ---------------------------------------------------------------------------
# ② Hero KPI cards
# ---------------------------------------------------------------------------
summary      = load_summary()
zone_temps   = load_zone_temps()
setpoint     = load_current_setpoint()
ai_df        = load_db_table("ai_results")
decisions_df = load_db_table("agent_decisions")
confidence, last_cycle_recs = load_agent_recs_for_confidence()

pct_reduction = summary.get("pct_energy_reduction")
# energy_kw field actually stores Electricity:Facility [J](Monthly)
# = total facility electricity in joules for the two design-day run period.
# Convert: J ÷ 3,600,000 = kWh
ai_energy_j   = summary.get("ai_avg_energy_kw")    # raw joules (legacy key name)
base_energy_j = summary.get("baseline_avg_energy_kw")  # raw joules
comfort_viol  = summary.get("comfort_violations")
ai_cycles     = summary.get("ai_cycles_run", 0)

# Comfort Score: fraction of zones inside 21–24°C comfort band
# Formula: (zones_in_band / total_zones) × 100
if zone_temps:
    in_band = sum(1 for v in zone_temps.values() if 21.0 <= v <= 24.0)
    comfort_score = round(in_band / len(zone_temps) * 100)
else:
    comfort_score = None

# Energy display values (raw J → kWh or MWh label)
ai_val, ai_unit     = joules_to_display(ai_energy_j)
base_val, base_unit = joules_to_display(base_energy_j)

# Energy saved: calculated by compute_savings.py from real simulation runs
pct_str   = f"{abs(pct_reduction):.1f}%" if pct_reduction is not None else "—"
pct_trend = "trend-down" if (pct_reduction or 0) < 0 else "trend-up"
pct_arrow = "↓" if (pct_reduction or 0) < 0 else "↑"  # ↑ = saved, ↓ = higher than baseline
comfort_trend_cls = "trend-up" if (comfort_score or 0) >= 80 else "trend-down"

st.markdown(f"""
<div class="kpi-grid">
  <div class="kpi-card green">
    <div class="kpi-top">
      <div class="kpi-icon">🌱</div>
      <div class="kpi-trend {pct_trend}">{pct_arrow} {pct_str}</div>
    </div>
    <div class="kpi-value">{pct_str}<span class="kpi-unit"></span></div>
    <div class="kpi-label">Energy Saved vs Baseline</div>
  </div>

  <div class="kpi-card blue">
    <div class="kpi-top">
      <div class="kpi-icon">⚡</div>
      <div class="kpi-trend trend-flat">AI-Controlled</div>
    </div>
    <div class="kpi-value">{ai_val}<span class="kpi-unit">{ai_unit}</span></div>
    <div class="kpi-label">Current Energy Consumption</div>
  </div>

  <div class="kpi-card purple">
    <div class="kpi-top">
      <div class="kpi-icon">🎯</div>
      <div class="kpi-trend {comfort_trend_cls}">
        {'↑ Good' if (comfort_score or 0) >= 80 else '↓ Review'}
      </div>
    </div>
    <div class="kpi-value">
      {'—' if comfort_score is None else comfort_score}<span class="kpi-unit">{'%' if comfort_score is not None else ''}</span>
    </div>
    <div class="kpi-label">Comfort Score (Zones in Band)</div>
  </div>

  <div class="kpi-card orange">
    <div class="kpi-top">
      <div class="kpi-icon">🤖</div>
      <div class="kpi-trend trend-up">↑ Active</div>
    </div>
    <div class="kpi-value">
      {'—' if confidence is None else confidence}<span class="kpi-unit">{'%' if confidence is not None else ''}</span>
    </div>
    <div class="kpi-label">AI Decision Confidence</div>
  </div>
</div>
""", unsafe_allow_html=True)

