def stat_card(icon, title, value, sub, border_color="#4299e1"):
    return f"""
    <div class="ov-card" style="border-top: 2px solid {border_color}; padding-top:14px">
      <div class="ov-card-icon">{icon}</div>
      <div class="ov-card-label">{title}</div>
      <div class="ov-card-value">{value}</div>
      <div class="ov-card-sub">{sub}</div>
    </div>
    """

with c1:
