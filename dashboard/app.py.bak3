    <div class="ov-card-sub">All zones mean</div>
  </div>
  <div class="ov-card">
    <div class="ov-card-icon">⚙️</div>
    <div class="ov-card-label">Energy Mode</div>
    <div class="ov-card-value" style="font-size:14px">{energy_mode}</div>
    <div class="ov-card-sub">{ai_cycles} AI cycles run</div>
  </div>
</div>
""", unsafe_allow_html=True)

# ---------------------------------------------------------------------------
# ④ Live Zone Temperatures
# ---------------------------------------------------------------------------
st.markdown("""
<div class="section-header">
  <div class="section-header-icon">📊</div>
  <span class="section-title">Live Zone Temperatures</span>
  <div class="section-line"></div>
</div>
""", unsafe_allow_html=True)

if zone_temps:
    zones  = list(zone_temps.keys())
    temps  = list(zone_temps.values())
    avg_t  = sum(temps) / len(temps)

    colors = []
    for t in temps:
        if t < 21.0:
            colors.append("#63b3ed")     # too cold → blue
        elif t > 24.0:
            colors.append("#fc8181")     # too hot → red
        else:
            colors.append("#68d391")     # comfort → green

    fig_zones = go.Figure()

    # Comfort band
    fig_zones.add_hrect(
        y0=21.0, y1=24.0,
        fillcolor="rgba(104,211,145,0.06)",
        line_width=0,
        annotation_text="Comfort Band (21–24°C)",
        annotation_font=dict(color="#4a5568", size=10),
        annotation_position="top right",
    )

    # Bar chart
    fig_zones.add_trace(go.Bar(
        x=zones, y=temps,
        marker=dict(
            color=colors,
            opacity=0.85,
            line=dict(color="rgba(0,0,0,0)", width=0),
        ),
        hovertemplate="<b>%{x}</b><br>Temp: %{y:.2f}°C<extra></extra>",
        width=0.6,
    ))

    # Average line
    fig_zones.add_hline(
        y=avg_t, line_dash="dot", line_color="#f6ad55", line_width=1.5,
        annotation_text=f"Avg {avg_t:.1f}°C",
        annotation_font=dict(color="#f6ad55", size=10),
        annotation_position="top left",
    )

    fig_zones.update_layout(
        **PLOTLY_LAYOUT,
        height=340,
        bargap=0.25,
    )
    fig_zones.update_xaxes(
        tickfont=dict(size=10, color="#718096"),
        tickangle=-40,
        **AXIS_STYLE,
    )
    fig_zones.update_yaxes(
        title=dict(text="Temperature (°C)", font=dict(size=11, color="#718096")),
        range=[min(min(temps)-1, 19.5), max(max(temps)+1, 25.5)],
        **AXIS_STYLE,
    )

    st.markdown('<div class="chart-card">', unsafe_allow_html=True)
    st.plotly_chart(fig_zones, use_container_width=True, config={"displayModeBar": False})
    st.markdown('</div>', unsafe_allow_html=True)
else:
    st.markdown("""
    <div class="chart-card">
      <div class="empty-state">
        <div class="empty-state-icon">📊</div>
        No simulation output found. Run <code>python sim_runner/eplus_interface.py</code> first.
      </div>
    </div>
    """, unsafe_allow_html=True)

# ---------------------------------------------------------------------------
# ⑤ AI Decision Timeline  +  Energy Comparison  (two columns)
# ---------------------------------------------------------------------------
col_timeline, col_energy = st.columns([1, 1], gap="large")

with col_timeline:
    st.markdown("""
    <div class="section-header">
      <div class="section-header-icon">🤖</div>
      <span class="section-title">AI Decision Timeline</span>
      <div class="section-line"></div>
    </div>
    """, unsafe_allow_html=True)

    AGENT_META = {
        "comfort_agent":  ("Comfort Agent",     "badge-comfort",   "dot-comfort",   "🎯"),
        "energy_agent":   ("Energy Agent",      "badge-energy",    "dot-energy",    "⚡"),
        "weather_agent":  ("Weather Agent",     "badge-weather",   "dot-weather",   "🌤️"),
        "carbon_agent":   ("Carbon Agent",      "badge-carbon",    "dot-carbon",    "🌱"),
        "coordinator":    ("Coordinator",       "badge-coordinator","dot-coordinator","🧠"),
        "single_agent":   ("Single Agent",      "badge-single_agent","dot-flat",    "🤖"),
    }

    if not decisions_df.empty and "agent" in decisions_df.columns:
        # Show most recent 8
        recent = decisions_df.head(8)
        st.markdown('<div class="timeline">', unsafe_allow_html=True)
        for _, row in recent.iterrows():
            agent_key  = str(row.get("agent", "")).lower()
            rationale  = str(row.get("rationale", ""))
            action     = str(row.get("action", ""))
            ts         = str(row.get("timestamp", ""))[:16].replace("T", " ")

            meta = AGENT_META.get(agent_key, (agent_key.title(), "badge-single_agent", "dot-flat", "🤖"))
            label, badge_cls, dot_cls, icon = meta

            st.markdown(f"""
            <div class="tl-item">
              <span class="tl-dot {dot_cls}" style="border-color:#0a0e1a"></span>
              <div class="tl-card">
                <div class="tl-header">
                  <span class="tl-agent">{icon} {label}</span>
                  <span class="tl-badge {badge_cls}">{ts}</span>
                </div>
                <div class="tl-rationale">{rationale[:180] + '…' if len(rationale) > 180 else rationale}</div>
                <div class="tl-action">→ {action}</div>
              </div>
            </div>
            """, unsafe_allow_html=True)
        st.markdown('</div>', unsafe_allow_html=True)
    else:
        st.markdown("""
        <div class="chart-card">
          <div class="empty-state">
            <div class="empty-state-icon">🤖</div>
            No agent decisions logged yet.<br>Run <code>python agents/graph.py</code>
          </div>
        </div>
        """, unsafe_allow_html=True)

with col_energy:
    st.markdown("""
    <div class="section-header">
      <div class="section-header-icon">⚡</div>
      <span class="section-title">Energy Comparison</span>
      <div class="section-line"></div>
    </div>
    """, unsafe_allow_html=True)

    # Bar: baseline vs AI
    if base_energy_j and ai_energy_j:
        base_kwh = base_energy_j / 3_600_000
        ai_kwh   = ai_energy_j   / 3_600_000

        fig_cmp = go.Figure(data=[
            go.Bar(
                name="Baseline",
                x=["Baseline"],
                y=[base_kwh],
                marker=dict(color="#4a5568", opacity=0.8),
                hovertemplate=f"Baseline: {base_kwh:,.1f} kWh<extra></extra>",
                width=0.35,
            ),
            go.Bar(
                name="AI-Controlled",
                x=["AI-Controlled"],
                y=[ai_kwh],
                marker=dict(
                    color="#4299e1" if ai_kwh <= base_kwh else "#fc8181",
                    opacity=0.9,
                ),
                hovertemplate=f"AI: {ai_kwh:,.1f} kWh<extra></extra>",
                width=0.35,
            ),
        ])

        delta_pct = (base_kwh - ai_kwh) / base_kwh * 100
        delta_txt = f"{'−' if delta_pct > 0 else '+'}{abs(delta_pct):.1f}% vs baseline"

        fig_cmp.update_layout(
            **PLOTLY_LAYOUT,
            height=200,
            barmode="group",
            showlegend=True,
            annotations=[dict(
                text=delta_txt,
                xref="paper", yref="paper", x=0.5, y=1.08,
                showarrow=False,
                font=dict(size=13, color="#68d391" if delta_pct > 0 else "#fc8181", family="Inter"),
                xanchor="center",
            )],
        )
        fig_cmp.update_xaxes(**AXIS_STYLE)
        fig_cmp.update_yaxes(**AXIS_STYLE)
        st.markdown('<div class="chart-card">', unsafe_allow_html=True)
        st.plotly_chart(fig_cmp, use_container_width=True, config={"displayModeBar": False})
        st.markdown('</div>', unsafe_allow_html=True)
    else:
        st.markdown("""
        <div class="chart-card" style="height:200px">
          <div class="empty-state" style="padding-top:40px">
            <div class="empty-state-icon">⚡</div>
            Run baseline + AI loop to compare.
          </div>
        </div>
        """, unsafe_allow_html=True)

    # Setpoint trend (AI cycles)
    st.markdown("""
    <div class="section-header" style="margin-top:24px">
      <div class="section-header-icon">🎯</div>
      <span class="section-title">Setpoint Trend</span>
      <div class="section-line"></div>
    </div>
    """, unsafe_allow_html=True)

    ai_results_df = load_db_table("ai_results")

    if not ai_results_df.empty and "final_temp" in ai_results_df.columns:
        ai_results_df = ai_results_df.sort_values("cycle") if "cycle" in ai_results_df.columns else ai_results_df
        cycles = ai_results_df.get("cycle", range(len(ai_results_df)))
        temps_ai = ai_results_df["final_temp"]

        fig_sp = go.Figure()
        fig_sp.add_hrect(y0=21, y1=24, fillcolor="rgba(104,211,145,0.06)", line_width=0)
        fig_sp.add_trace(go.Scatter(
            x=list(cycles), y=list(temps_ai),
            mode="lines+markers",
            name="AI Setpoint",
            line=dict(color="#4299e1", width=2),
            marker=dict(size=7, color="#4299e1", line=dict(color="#0a0e1a", width=1.5)),
            hovertemplate="Cycle %{x}: %{y:.1f}°C<extra></extra>",
            fill="tozeroy",
            fillcolor="rgba(66,153,225,0.04)",
        ))
        fig_sp.update_layout(**PLOTLY_LAYOUT, height=200)
        fig_sp.update_xaxes(title=dict(text="Cycle", font=dict(size=10)), dtick=1, **AXIS_STYLE)
        fig_sp.update_yaxes(title=dict(text="°C", font=dict(size=10)), range=[19, 26], **AXIS_STYLE)
        st.markdown('<div class="chart-card">', unsafe_allow_html=True)
        st.plotly_chart(fig_sp, use_container_width=True, config={"displayModeBar": False})
        st.markdown('</div>', unsafe_allow_html=True)
    else:
        st.markdown("""
        <div class="chart-card" style="height:160px">
          <div class="empty-state" style="padding-top:30px">
            <div>No AI cycle data yet.</div>
          </div>
        </div>
        """, unsafe_allow_html=True)

