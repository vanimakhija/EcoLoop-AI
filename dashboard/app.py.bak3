st.markdown("""
<div class="section-header">
  <div class="section-header-icon">🏢</div>
  <span class="section-title">Building Overview</span>
  <div class="section-line"></div>
</div>
""", unsafe_allow_html=True)

avg_temp = round(sum(zone_temps.values()) / len(zone_temps), 1) if zone_temps else None
setpoint_disp = f"{setpoint} °C" if setpoint is not None else "—"
avg_temp_disp = f"{avg_temp} °C" if avg_temp is not None else "—"

# Determine energy mode
if pct_reduction is not None:
    if pct_reduction > 5:
        energy_mode = "🟢 Eco Optimized"
    elif pct_reduction > 0:
        energy_mode = "🟡 Balanced"
    else:
        energy_mode = "🔴 Baseline Mode"
else:
    energy_mode = "⚪ No Data"

hvac_status = "🟢 Active" if sim_status == "ok" else "⚪ Standby"

st.markdown(f"""
<div class="overview-grid">
  <div class="ov-card">
    <div class="ov-card-icon">❄️</div>
    <div class="ov-card-label">HVAC Status</div>
