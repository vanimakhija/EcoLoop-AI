# ---------------------------------------------------------------------------
# Helper: unit conversion (J → kWh or MWh)
# ---------------------------------------------------------------------------
def joules_to_display(j):
    """Convert joules to a human-readable string."""
    if j is None or (isinstance(j, float) and j != j):
        return "—", ""
    j = float(j)
    kwh = j / 3_600_000          # 1 kWh = 3.6 MJ
    if kwh >= 1_000_000:
        return f"{kwh/1_000_000:.2f}", "GWh"
    elif kwh >= 1_000:
        return f"{kwh/1_000:.1f}", "MWh"
    else:
        return f"{kwh:.1f}", "kWh"


def joules_to_kw_display(j):
    """For demand values, show as kW (assumes J reported per hour = Wh → /1000 = kWh → treat as kW avg)."""
    val, unit = joules_to_display(j)
    return val, unit


# ---------------------------------------------------------------------------
# Data loaders (read-only — no simulations triggered)
# ---------------------------------------------------------------------------
@st.cache_data(ttl=30)
def load_summary():
    if os.path.exists(SUMMARY_PATH):
        with open(SUMMARY_PATH) as f:
            return json.load(f)
    return {}

@st.cache_data(ttl=30)
def load_agent_recs_for_confidence():
    """
    Compute AI confidence from the spread of agent recommendations.

    Formula:
        1. For each coordinator decision cycle, collect the 4 specialist
           recommendations (comfort, energy, weather, carbon).
        2. Compute the standard deviation of those 4 values.
        3. Confidence = 100 - (std_dev / max_range × 100), where
           max_range = TEMP_MAX - TEMP_MIN = 3.0°C.
           A std_dev of 0 → agents fully agree → 100% confidence.
           A std_dev of 1.5 → half the range → 50% confidence.
        4. Average across all logged cycles, clamp to [0, 100].

    Returns:
        confidence (int | None): 0-100%, or None if no data.
        raw_recs (list[float]): most-recent cycle's recommendations for display.
    """
    if not os.path.exists(DB_PATH):
        return None, []
    try:
        conn = sqlite3.connect(DB_PATH)
        # Load agent decisions; each row has agent name and action string like 'recommended 23.5'
        df = pd.read_sql(
            "SELECT agent, action, timestamp FROM agent_decisions ORDER BY timestamp", conn
        )
        conn.close()
        if df.empty:
            return None, []

        SPECIALIST_AGENTS = {"comfort_agent", "energy_agent", "weather_agent", "carbon_agent"}
        TEMP_RANGE = 3.0   # 24.0 - 21.0

        # Extract numeric recommendations from action strings like 'recommended 23.5'
        import re as _re
        def extract_temp(action_str):
            m = _re.search(r'(-?\d+\.?\d*)', str(action_str))
            return float(m.group(1)) if m else None

        df["temp_rec"] = df["action"].apply(extract_temp)
        df = df[df["agent"].isin(SPECIALIST_AGENTS) & df["temp_rec"].notna()]

        if df.empty:
            return None, []

        # Group by approximate time windows (every 5 rows = one cycle)
        # Since agents run sequentially, group by timestamp proximity
        df["timestamp"] = pd.to_datetime(df["timestamp"], errors="coerce")
        df = df.sort_values("timestamp")

        # Build cycles: collect groups of 4 consecutive specialist agent rows
        cycle_stds = []
        recs = df["temp_rec"].tolist()
        for i in range(0, len(recs) - 3, 4):
            group = recs[i:i+4]
            if len(group) == 4:
                import statistics
                std = statistics.stdev(group) if len(set(group)) > 1 else 0.0
                cycle_stds.append(std)

        if not cycle_stds:
            return None, recs[-4:]

        avg_std = sum(cycle_stds) / len(cycle_stds)
        # Clamp: std of 0 → 100%, std >= TEMP_RANGE → 0%
        confidence = int(max(0, min(100, round(100 - (avg_std / TEMP_RANGE * 100)))))
        return confidence, recs[-4:] if len(recs) >= 4 else recs
    except Exception:
        return None, []

@st.cache_data(ttl=30)
def load_db_table(table: str):
    if not os.path.exists(DB_PATH):
        return pd.DataFrame()
    try:
        conn = sqlite3.connect(DB_PATH)
        df = pd.read_sql(f"SELECT * FROM {table} ORDER BY rowid DESC LIMIT 100", conn)
        conn.close()
        return df
    except Exception:
        return pd.DataFrame()

@st.cache_data(ttl=30)
def load_zone_temps():
    if not os.path.exists(CSV_PATH):
        return {}
    try:
        df = pd.read_csv(CSV_PATH)
        # Drop rows where all temp cols are NaN (the sub-hourly rows)
        temp_cols = [c for c in df.columns if "zone mean air temperature" in c.lower()]
        if not temp_cols:
            return {}
        df_temps = df[temp_cols].dropna()
        if df_temps.empty:
            return {}
        last = df_temps.iloc[-1]
        result = {}
        for col in temp_cols:
            zone = col.split(":")[0].replace("_", " ").title()
            result[zone] = round(float(last[col]), 2)
        return result
    except Exception:
        return {}

@st.cache_data(ttl=30)
def load_sim_status():
    if not os.path.exists(ERR_PATH):
        return "none", "No simulation run yet"
    with open(ERR_PATH, "r", encoding="utf-8", errors="ignore") as f:
        txt = f.read()
    if "Completed Successfully" in txt:
        # Extract elapsed time
        for line in txt.split("\n"):
            if "Elapsed Time" in line:
                elapsed = line.strip().lstrip("*").strip()
                return "ok", elapsed
        return "ok", "Completed"
    elif "Fatal" in txt:
        return "err", "Fatal error — check eplusout.err"
    return "warn", "Unknown status"

@st.cache_data(ttl=30)
def load_current_setpoint():
    if not os.path.exists(IDF_PATH):
        return None
    try:
        with open(IDF_PATH, "r", encoding="utf-8", errors="ignore") as f:
            txt = f.read()
        m = re.search(
            r'Schedule:Compact,\s*\n\s*CLGSETP_SCH.*?;[^\n]*',
            txt, re.DOTALL | re.IGNORECASE
        )
        if not m:
            return None
        temps = re.findall(r'\n\s+(-?\d+\.?\d*)\s*[,;]\s+!-\s*Field\s+\d+', m.group())
        return float(temps[0]) if temps else None
    except Exception:
        return None


